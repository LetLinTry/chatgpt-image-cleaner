{
  "manifest_version": 3,
  "name": "ChatGPT 图片清理器",
  "version": "2.4.4",
  "description": "通过 ChatGPT 网页接口分页扫描并批量删除资料库中的图片。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "action": {
    "default_title": "ChatGPT 图片清理器",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/dom.js",
        "src/api-client.js",
        "src/cleaner.js",
        "src/controller.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
